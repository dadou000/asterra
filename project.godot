; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Asterra"
config/description="Systems-first open-world simulation. Phase 1: procedural planet."
config/version="0.0.5"
run/main_scene="res://scenes/StartMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Frames="*res://scripts/core/frames.gd"
Planet="*res://scripts/gen/planet_sampler_smooth2x.gd"
Deltas="*res://scripts/terrain/terrain_deltas.gd"
GroundHeightStore="*res://scripts/terrain/planet_height_store_procedural.gd"
GroundHeightPageAtlas="*res://scripts/terrain/planet_height_page_atlas_safe.gd"
GroundTerrainPrefetcher="*res://scripts/terrain/ground_prefetcher_gpu_visual.gd"
CoastlineClipmap="*res://scripts/terrain/coastline_clipmap.gd"
MaterialClipmap="*res://scripts/terrain/material_clipmap.gd"
GroundGeometryClipmap="*res://scripts/terrain/spherical_geometry_clipmap_procedural.gd"
AppSettings="*res://scripts/core/app_settings.gd"
ClosestCharacterDebug="*res://scripts/ui/closest_character_debug.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[input]

