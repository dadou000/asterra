; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Asterra"
config/description="Systems-first open-world simulation. Phase 1: procedural planet."
config/version="0.1.0-pre"
run/main_scene="res://scenes/StartMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Frames="*res://scripts/core/frames.gd"
CelestialSystem="*res://scripts/core/weather_celestial_clock_adapter.gd"
Planet="*res://scripts/gen/planet_sampler_gpu_runtime.gd"
PlanetContext="*res://scripts/terrain/gpu_planet_context.gd"
TerrainHeightQuery="*res://scripts/terrain/gpu_terrain_height_query_contact_phase30.gd"
Deltas="*res://scripts/terrain/terrain_deltas.gd"
TerrainDeformationGPU="*res://scripts/terrain/gpu_terrain_deformation.gd"
TerrainDeformationQueryGPU="*res://scripts/terrain/gpu_terrain_deformation_query_contact.gd"
TerrainDeformation="*res://scripts/terrain/terrain_deformation_physics_coupled.gd"
TerrainEditDeltaGPU="*res://scripts/terrain/gpu_terrain_edit_delta_optimized.gd"
GroundHeightStore="*res://scripts/terrain/global_height_store.gd"
GroundHeightPageAtlas="*res://scripts/terrain/ground_height_page_atlas_disabled.gd"
GroundTerrainPrefetcher="*res://scripts/terrain/ground_prefetcher_gpu_visual.gd"
CoastlineClipmap="*res://scripts/terrain/coastline_clipmap.gd"
OceanSystem="*res://scripts/terrain/ocean_geometry_clipmap.gd"
WaterSystem="*res://scripts/water/water_system_hydrolod_subcycled_production.gd"
SparseHydroSurfaceCache="*res://scripts/water/sparse_hydro_surface_cache_bridge.gd"
LocalWaterSurface="*res://scripts/water/local_water_surface.gd"
PlanetStudioWaterSources="*res://scripts/world_authoring/planet_studio_water_source_bridge.gd"
GroundGeometryClipmap="*res://scripts/terrain/spherical_geometry_clipmap_phase31.gd"
Bodies="*res://scripts/core/body_runtime_pool.gd"
RenderedTerrainContactQuery="*res://scripts/terrain/gpu_rendered_terrain_contact_query_stable.gd"
TerrainScatter="*res://scripts/terrain/gpu_terrain_scatter_authoring_empty.gd"
TerrainHeightDebugOverlay="*res://scripts/terrain/terrain_height_debug_overlay.gd"
TerrainDeformationExperiment="*res://scripts/terrain/terrain_deformation_experiment_gpu_safe.gd"
AppSettings="*res://scripts/core/app_settings.gd"
ClosestCharacterDebug="*res://scripts/ui/closest_character_debug.gd"
WeatherNativeBootstrap="*res://scripts/weather/weather_native_bootstrap.gd"
WeatherSystem="*res://scripts/weather/weather_system.gd"
PersistentHydrologySystem="*res://scripts/water/persistent_hydrology_reach_system.gd"
HydroWeatherCoupling="*res://scripts/water/hydro_weather_coupling.gd"
HydroAutomaticSurfacePromotion="*res://scripts/water/hydro_automatic_surface_promotion.gd"
HydroAutomaticSurfaceDemotion="*res://scripts/water/hydro_automatic_surface_demotion.gd"
HydroChannelRefinement="*res://scripts/water/hydro_automatic_channel_refinement_cluster_capacity.gd"
HydroFineExternalFluxLedger="*res://scripts/water/hydro_fine_external_flux_ledger.gd"
WeatherRefinement="*res://scripts/weather/weather_refinement_manager_v2.gd"
SurfaceEnergy="*res://scripts/weather/surface_energy_bridge.gd"
WeatherMap="*res://scripts/ui/weather_map.gd"
VolumetricClouds="*res://scripts/rendering/weather_volumetric_cloud_controller.gd"
RenderDebug="*res://scripts/rendering/render_debug_controller.gd"
RingCountDebug="*res://scripts/terrain/ring_count_debug_controller.gd"
VehicleTests="*res://scripts/vehicles/vehicle_test_harness.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

