; Minimal Asterra 19-body ragdoll experiment project.
; No game autoloads, terrain, weather, UI or gameplay systems are enabled here.

config_version=5

[application]

config/name="Asterra 19-Body Ragdoll Test"
run/main_scene="res://scenes/ragdoll_test.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=120
common/physics_interpolation=true
3d/default_gravity=9.81
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/position_steps=8
jolt_physics_3d/simulation/velocity_steps=20
jolt_physics_3d/simulation/penetration_slop=0.005
jolt_physics_3d/limits/max_angular_velocity=30.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.03, 0.04, 1)
