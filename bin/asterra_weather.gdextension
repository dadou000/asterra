[configuration]
entry_symbol = "asterra_weather_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
windows.debug.x86_64 = "res://bin/asterra_weather.dll"
windows.release.x86_64 = "res://bin/asterra_weather.dll"
linux.debug.x86_64 = "res://bin/libasterra_weather.so"
linux.release.x86_64 = "res://bin/libasterra_weather.so"
